{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "fonts",
      "installMode": "prefetch",
      "resources": {
        "files": ["/assets/fonts/**", "/*.(woff|woff2|ttf|otf|eot)"]
      }
    },
    {
      "name": "images",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/assets/images/**",
          "/assets/icons/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|ico)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "app-data",
      "urls": ["/assets/data/*.json", "/api-data/*.json"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 32,
        "maxAge": "1d",
        "timeout": "10s"
      }
    }
  ]
}
