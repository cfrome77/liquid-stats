# API credentials (example: Untappd)
CLIENT_ID='YOUR_CLIENT_ID_HERE'
CLIENT_SECRET='YOUR_CLIENT_SECRET_HERE'
UNTAPPD_USERNAME='YOUR_USERNAME_HERE'

# Deployment / Terraform settings
S3_BUCKET_NAME=""
LAMBDA_ZIP_FILE='lambda_function.zip'
# Where the Angular app reads its JSON from. Empty falls back to the bundled
# assets/data fixtures; in production this is the S3 bucket (see netlify.toml).
DATA_URL='https://YOUR_BUCKET_NAME.s3.amazonaws.com/'

# List of allowed origins for S3 CORS (e.g., "http://localhost:4200,https://your-site.com")
ALLOWED_CORS_ORIGINS=""
GA4_MEASUREMENT_ID='G-XXXXXXXXXX'  # Replace with your GA4 Measurement ID